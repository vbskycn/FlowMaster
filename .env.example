# 监听地址与端口
HOST=0.0.0.0
PORT=10089

# 持久化数据目录（存放 SQLite 数据库、自动生成的 0600 会话密钥、轮转日志与快照备份）
DATA_DIR=./data

# 实时内核采样间隔（毫秒，范围 1000..60000，默认 1000 即 1 秒级实时推送）
REALTIME_INTERVAL_MS=1000

# 可选：外部 vnstat 命令与数据库目录（Hybrid / vnstat 模式读取或历史数据导入使用）
VNSTAT_BIN=vnstat
VNSTAT_DB_DIR=
VNSTAT_COMMAND_TIMEOUT_MS=15000
VNSTAT_MAX_CONCURRENCY=4

# 日期范围查询上限（天）
MAX_RANGE_DAYS=3660

# API 限流（每客户端每窗口最大请求数）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_MAX_CLIENTS=10000

# 管理员初始登录密码（可选；未设置时首次打开后台页面将引导初始化密码）
ADMIN_PASSWORD=

# 可选 API 管理令牌（请求头 X-Admin-Token），留空时仅允许后台会话登录访问管理接口
ADMIN_TOKEN=
ALLOW_ANONYMOUS_ADMIN=false

# 会话签名密钥（留空或弱值时将自动在 DATA_DIR/session.key 生成 32 字节加密随机密钥）
SESSION_SECRET=

# 可选：逗号分隔的精确跨域白名单，留空时不发送 CORS 许可头
CORS_ORIGINS=

# 仅当服务位于可信 HTTPS 反向代理后方时设为 true（用于识别客户端 IP 与动态启用 Secure Cookie）
TRUST_PROXY=false
