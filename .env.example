# 服务器端口配置
HOST=0.0.0.0
PORT=10089
NODE_ENV=production

# 缓存配置
CACHE_MAX_SIZE=100
CACHE_MAX_MEMORY_MB=50
CACHE_CLEANUP_INTERVAL=60000
MEMORY_MONITOR_INTERVAL=300000

# vnstat 与查询限制
VNSTAT_COMMAND_TIMEOUT_MS=15000
MAX_RANGE_DAYS=3660

# API 限流
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
RATE_LIMIT_MAX_CLIENTS=10000

# 可选：逗号分隔的跨域来源。留空表示不发送 CORS 许可头。
CORS_ORIGINS=

# 可选：设置后，清空缓存和 vnstat 诊断接口要求 X-Admin-Token。
ADMIN_TOKEN=

# 仅位于可信反向代理后方时启用
TRUST_PROXY=false
