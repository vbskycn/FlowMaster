# 服务器端口配置
HOST=0.0.0.0
PORT=10089
NODE_ENV=production

# 缓存配置
CACHE_MAX_SIZE=100
CACHE_MAX_MEMORY_MB=50
CACHE_CLEANUP_INTERVAL=60000
MEMORY_MONITOR_INTERVAL=300000

# vnstat 与查询限制；非法或越界整数会回退到默认值
VNSTAT_COMMAND_TIMEOUT_MS=15000
VNSTAT_MAX_CONCURRENCY=4
VNSTAT_MAX_QUEUE=256
MAX_RANGE_DAYS=3660

# 实时采集：按访问启动，空闲后自动回收
REALTIME_INTERVAL_MS=5000
REALTIME_IDLE_TIMEOUT_MS=30000
REALTIME_MAX_STALE_MS=15000
# 实际活跃上限还会受 VNSTAT_MAX_CONCURRENCY 限制，为其他查询保留容量
REALTIME_MAX_ACTIVE=2
REALTIME_MAX_BACKOFF_MS=60000

# API 限流
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
RATE_LIMIT_MAX_CLIENTS=10000

# 可选：逗号分隔的跨域来源。留空表示不发送 CORS 许可头。
CORS_ORIGINS=

# 管理接口默认拒绝匿名访问；生产环境应设置令牌并使用 X-Admin-Token
ADMIN_TOKEN=
# ADMIN_TOKEN 留空时，仅为兼容受信任内网的旧调用方才改为 true
ALLOW_ANONYMOUS_ADMIN=false

# 仅位于可信反向代理后方时启用
TRUST_PROXY=false
