    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "chart.js": "4.5.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "vue": "3.5.42"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbskycn/FlowMaster.git"
  },
